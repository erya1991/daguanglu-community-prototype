docs/stages/stage-00/evidence/r2-followup/logs/old-browser-evidence-hashes-*.json whitespace=trailing-space,space-before-tab,cr-at-eol

# R3 owner inputs and tool logs are immutable raw-byte evidence.
docs/stages/stage-00/evidence/r3/input/** -text
